# HoneyTrack Environment Configuration Template
# Copy this file to .env and configure your credentials

SECRET_KEY=generate_with_python_secrets_token_hex_32

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_account@gmail.com
SMTP_PASSWORD=your_16_character_app_password
ALERT_FROM_EMAIL=your_account@gmail.com
ALERT_TO_EMAIL=your_account@gmail.com
EMAIL_ALERTS_ENABLED=True

# Active Defense Firewall Policy
FIREWALL_AUTO_BLOCK_ENABLED=True
FIREWALL_AUTO_BLOCK_THRESHOLD=85
FIREWALL_BLOCK_TOR_EXIT_NODES=False
FIREWALL_EXECUTE_SYSTEM_RULES=False

# Distributed Sensor Node Federation (v2.0)
FEDERATION_ENABLED=True
NODE_ID=honeytrack-primary-sensor
NODE_NAME=HoneyTrack Primary Node
NODE_REGION=AP-SOUTH-1 (Mumbai)
FEDERATION_SECRET=change_me_to_a_secure_shared_federation_key
FEDERATION_HUB_URL=
FEDERATION_SYNC_INTERVAL_SEC=30

